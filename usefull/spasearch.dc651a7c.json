{"main":"<div id=\"catalog\"> <div class=\"catalog-page\" data-link=\"class{merge: emptySearch toggle='hide'}\"> <div class=\"catalog-page__searching-results searching-results\"> {^{if isEmpty}} <p class=\"searching-results__text\"> {^{:~t('catalog.nothingFoundByRequestShowedSimilar', { \"request\": '<a class=\"searching-results__query-replaced\" data-link=\"text{:&apos;«&apos; + xData.userSearch + &apos;»&apos;}href{:getRawSearchUrl(xData.originalSearch)}{on onSpellcheckClick}\"></a>', \"similarRequest\": '<span class=\"searching-results__query\" data-link=\"text{:&apos;«&apos; + xData.title + &apos;»&apos;}\"></span>' })}} </p> {{else}} <p class=\"searching-results__text\" data-link=\"class{merge: !modifiedSearch toggle='hide'}\"> {^{if !xData.change_input}} {^{:~t('catalog.resultsByRequest', { \"request\": '<a class=\"searching-results__query-replaced\" data-link=\"text{:&apos;«&apos; + xData.title + &apos;»&apos;}href{:getRawSearchUrl(xData.title)}\"></a>' })}} {{else}} {^{:~t('catalog.resultsByRequest', { \"request\": '<span class=\"searching-results__query\" data-link=\"text{:&apos;«&apos; + xData.title + &apos;»&apos;}\"></span>' })}} {{/if}} {^{:~t('catalog.youLookedFor', { \"request\": '<a class=\"searching-results__query-replaced\" data-link=\"text{:xData.userSearch}href{:getRawSearchUrl(xData.originalSearch)}{on onSpellcheckClick}\"></a>' })}} </p> {{/if}} <div class=\"searching-results__inner\"> <h1 class=\"searching-results__title\" data-link=\"text{:title}\"></h1> <span class=\"searching-results__count\" data-link=\"class{merge: pagerModel.totalItems <= 0 toggle='hide'}\"> {^{:~plural('catalog.goodsFound', { \"count\": pagerModel.totalItems, \"displayCount\": '<span data-link=\"html{spaceFormatted:pagerModel.totalItems}\"></span>' })}} </span> </div> <a class=\"searching-results__suggest hide-mobile\" data-link=\"href{: '/recommendationssearch?searchQuery=' + xData.search + '&targetUrl=IM'}\" >{{:~t('recommendations.recommendationsForYou')}}</a> </div> <p class=\"j-open-tecdoc-mobile selection-btn hide-desktop\" data-link=\"class{merge: tecDocModel == null toggle='hide'}{on openTecdocSearchFormPopup}\"> {{:~t('catalog.selectByTransport')}} </p> {^{if tecDocModel && ~wbSettings.displayMode == 'd'}} <div class=\"j-tec-doc-wrapper\" data-link=\"{include tecDocModel tmpl=(tecDocModel && tecDocModel.template)}\"></div> {{/if}} <div class=\"catalog-page__search-tags\" data-link=\"{include searchTagsModel tmpl=searchTagsModel.template ~isTop=true ~sendOnClickAnalaytics=sendOnClickAnalaytics}\"></div> <div class=\"catalog-page__filters-block\" data-link=\"{include panelModel tmpl=panelModel.template}\"> </div> <div class=\"catalog-page__main new-size\" data-link=\"{include goodsList tmpl=goodsList.template}class{merge: sizerModel.currentCardSize == 1 toggle='catalog-big-card'}\"> </div> {^{if !enableAutoNextPage}} <div class=\"pagination\" data-link=\"{include pagerModel tmpl=pagerModel.template}\"> </div> {{/if}} <div data-link=\"{include searchTagsModel tmpl=searchTagsModel.template ~sendOnClickAnalaytics=sendOnClickAnalaytics}\"></div> {^{if showCarousels}} {^{recommendations noProcessResponse=true fetchUrl='https://search-goods.wildberries.ru/search' query_query=xData.search title=~t('catalog.youMayBeInterested') useLight=true analiticsCode='SCL' ~showRating=true ~showAddBasket=true ~showDelivery=true ~sameWindow=~checkProductOpenSameWindowAb/}} {{/if}} <div class=\"catalog-page__goods-slider\" data-link=\"{recentItems title=~t('common.youRecentlyViewed') showAll=true showSale=true analiticsCode='CCR' ~showRating=true ~showAddBasket=true ~showDelivery=true ~sameWindow=~checkProductOpenSameWindowAb}\"></div> <button class=\"btn-quick-nav j-quicknav btn-quick-nav--mobile\" type=\"button\">{{:~t('common.toTheTopPage')}}</button> </div> </div> {^{if emptySearch}} <div class=\"catalog-page catalog-page--non-search\"> <div class=\"catalog-page__main\"> <div class=\"catalog-page__not-found not-found-search\"> <div class=\"not-found-search__wrap\"> <h1 class=\"not-found-search__title\"> {^{:~t('catalog.nothingFoundByRequest', { \"request\": '&laquo;<span data-link=\"html{>xData.nocorrection? xData.userSearch:xData.search}\"></span>&raquo;' })}} </h1> <p class=\"not-found-search__text\">{{:~t('catalog.tryOtherRequest')}}</p> </div> </div> <div data-link=\"{include searchTagsModel tmpl=searchTagsModel.template ~analiticsCode='STR'}\"></div> <section class=\"catalog-page__section\" data-link=\"class{merge: !recommendationsFound toggle='hide'}\"> <h2 class=\"catalog-page__section-header section-header\">{{:~t('catalog.youMayBeInterested')}}</h2> <div data-link=\"{include recommList tmpl=recommList.template}\"></div> </section> <div class=\"catalog-page__goods-slider\" data-link=\"{recentItems title=~t('common.youRecentlyViewed') analiticsCode='CCR' ~showRating=true ~showAddBasket=true ~showDelivery=true ~sameWindow=~checkProductOpenSameWindowAb}\"></div> </div> </div> {{/if}}"}