ar-history-all' clearAllSearchHistories} {on 'click' '.j-clear-history' clearSearchHistory}\"> {^{for suggestions ~markSelected=markSelected ~searchText=searchText}} {{if suggestions.length}} {{if type == 6}} {{include tmpl='tagsSuggestionsTemplate' /}} {{else type == 0 || type == 1}} {{include tmpl='commonSuggestionsTemplate' /}} {{else type == 5}} {{include tmpl='suggestionsExtendedTemplate' /}} {{/if}} {{/if}} {{/for}} </div>"}