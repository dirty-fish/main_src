{"searchSuggestionsTmpl":"<div class=\"autocomplete__content\"> <div class=\"autocomplete__scroll-container\" data-link=\"class{merge: !searchText toggle='autocomplete__scroll-container--gap'}\"> {^{for suggestions ~markSelected=markSelected ~searchText=searchText}} {{if suggestions.length}} {{if type == 6 && ~tagTest}} {{include tmpl='tagsSuggestionsTemplate' /}} {{else type == 0 || type == 1}} {{include tmpl='commonSuggestionsTemplate' /}} {{else type == 5}} {{include tmpl='suggestionsExtendedTemplate' /}} {{/if}} {{/if}} {{/for}} </div> </div>","commonSuggestionsTemplate":"<div class=\"autocomplete\"> <div class=\"autocomplete__title\" data-link=\"class{merge: ~searchText toggle='hide'}\">{{if type == 0}}{{:~t('catalog.youSearched')}}{{else}}{{:~t('catalog.oftenSearched')}}{{/if}} </div> <ul class=\"autocomplete__list {{if type==0}}autocomplete__list--history{{else}}autocomplete__list--catalog{{/if}}\"> {{for suggestions}} <li class=\"autocomplete__item j-suggest\" data-link=\"class{merge: selected toggle='selected'}\"> <p class=\"autocomplete__text\"> <span class=\"autocomplete__icon {{if type==0}}autocomplete__icon--clock{{else}}loupe{{/if}}\"></span> <span class=\"autocomplete__phrase\">{{: ~markSelected(name, ~searchText)}}</span> </p> {{if type == 0}} <button class=\"autocomplete__delete j-clear-history\" type=\"button\" aria-label=\"{{:~t('common.removeBtn')}}\"></button> {{/if}} </li> {{/for}} </ul> </div>","suggestionsExtendedTemplate":"<ul class=\"autocomplete__list autocomplete__list--grouped\"> {{for suggestions}} <li class=\"autocomplete__item j-suggest autocomplete__item--{{:typeStr}}\" data-link=\"class{merge: selected toggle='selected'}\" data-type='{{:typeStr}}'> <img class=\"autocomplete__{{:typeStr}}-logo\" src=\"{{:src}}\" data-src-pb=\"{{:srcReserve}}\" data-src-pc=\"{{:imgOnError}}\" width=\"{{:imgWidth}}\" height=\"{{:imgHeight}}\" alt=\"{{> name}}\"> <p class=\"autocomplete__text\"> <span class=\"autocomplete__phrase\">{{: ~markSelected(nam